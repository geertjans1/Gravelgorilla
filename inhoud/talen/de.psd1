    'gravelbanden-kiezer' = @{ kop = 'Gravelreifen-<wbr><span class="groen">Finder</span>'; titel = 'Gravelreifen-Finder'; seoTitel = 'Welcher Gravelreifen passt zu dir? Reifen-Finder | Gravel Gorilla'
