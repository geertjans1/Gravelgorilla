    'maatbepaler' = @{ kop = 'Größen<wbr><span class="groen">rechner</span>'; titel = 'Rahmengrößen-Rechner'; seoTitel = 'Welche Rahmengröße beim Gravelbike? Größenrechner | Gravel Gorilla'
      sub = 'Gib Körpergröße und Schrittlänge ein und sieh, welche Rahmengröße, Sattelhöhe sowie Stack und Reach passen. Auch wenn du zwischen zwei Größen liegst.'; beschrijving = 'Welche Rahmengröße brauchst du beim Gravelbike? Berechne sie aus Körpergröße und Schrittlänge, plus Sattelhöhe, Stack und Reach. Mit Rat zwischen zwei Größen.'
      naamKort = 'Größenrechner'; kort = 'Körpergröße und Schrittlänge eingeben und sehen, welche Rahmengröße und Sattelhöhe passen. Auch zwischen zwei Größen.'; uitlegKop = 'So wählst du die richtige Rahmengröße'; label = 'Neu' }
    'paklijst-bikepacking' = @{ kop = 'Pack<wbr><span class="groen">liste</span>'; titel = 'Bikepacking-Packliste'; seoTitel = 'Bikepacking-Packliste: was nimmst du mit? | Gravel Gorilla'
