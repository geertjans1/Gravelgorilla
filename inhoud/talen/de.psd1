      naamKort = 'Packliste'; kort = 'Eine Checkliste nach Tourdauer und Jahreszeit, mit dem Gewicht deines Gepäcks.'; uitlegKop = 'Nie mehr etwas vergessen'; label = 'Neu' }
    'gravelroutes' = @{ kop = 'Gravel<wbr><span class="groen">routen</span>'; titel = 'Gravelrouten in den Niederlanden und Belgien'; seoTitel = 'Gravelrouten in den Niederlanden und Belgien | Gravel Gorilla'
      sub = 'Offizielle Gravelrouten und GPX-Routen in den Niederlanden und Flandern. Wähle eine Provinz, eine Länge und wie du den Weg findest.'; beschrijving = 'Gravelrouten in den Niederlanden und Belgien: ausgeschilderte Routen und GPX-Routen nach Provinz, filterbar nach Länge. Mit Links zur offiziellen Quelle.'
      naamKort = 'Gravelrouten'; kort = 'Ausgeschilderte Gravelrouten und GPX-Routen in den Niederlanden und Flandern, nach Provinz und Länge.'; uitlegKop = 'Graveln, wo es erlaubt ist'; label = 'Neu' }
    'versnellingscalculator' = @{ kop = 'Übersetzungs<wbr><span class="groen">rechner</span>'; titel = 'Übersetzungsrechner'; seoTitel = 'Übersetzungsrechner fürs Gravelbike | Gravel Gorilla'
      sub = 'Wähle Kettenblatt und Kassette und sieh deinen leichtesten Gang, deine Höchstgeschwindigkeit und wie steil du noch fahren kannst. Vergleiche zwei Setups.'; beschrijving = 'Welches Kettenblatt und welche Kassette fürs Gravelbike? Berechne leichtesten Gang, Höchsttempo und die steilste machbare Steigung und vergleiche zwei Setups.'
      naamKort = 'Übersetzung'; kort = 'Kettenblatt und Kassette vergleichen: dein leichtester Gang und wie steil du noch hochkommst.'; uitlegKop = 'Die richtige Übersetzung für jeden Anstieg'; label = 'Neu' }
  }

