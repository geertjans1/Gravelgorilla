@{
  # Duits — gebruikt door .claude/bouw-site.ps1. Pagina's komen in /de/.
  taal = 'de'; pre = '/de'; ogLocale = 'de_DE'; naam = 'Deutsch'; kort = 'DE'

  ui = @{
    brandAria = 'Gravel Gorilla, zur Startseite'; menuAria = 'Hauptmenü'; tools = 'Tools'; overOns = 'Über uns'; contact = 'Kontakt'; privacy = 'Datenschutz'
    themaAria = 'Dunkelmodus ein oder aus'; themaTitel = 'Nachtfahrt an/aus'; startKiezer = 'Zum Bike-Finder'; menuOpen = 'Menü öffnen'; taalAria = 'Sprache wählen'
    voetSlot = 'Der Gorilla zeigt den Weg.<br>Du fährst.'; voetNav = 'Fußzeile'
    voetKlein = '© 2026 Gravel Gorilla · gemacht von Geert Jans, Gravelfahrer · keine Cookies, keine Werbung'
    terugTools = '← Zurück zu allen Tools'; home = '← Startseite'; faqKop = 'Häufige Fragen'; andereKop = 'Weitere <span class="groen">Tools</span>'
    deel = 'Tool teilen'; deelVraag = 'Praktisch? Schick dieses Tool an deine Radkumpels.'; deelKopie = 'Link kopieren'; deelGekopieerd = 'Link kopiert!'; deelMail = 'E-Mail'; deelOnderwerp = 'Praktisches Tool für Gravelfahrer'; stemVraag = 'Wie findest du dieses Tool? Deine Stimme entscheidet, was zuerst verbessert wird.'; volgendeKop = 'Nächster <span class="groen">Schritt</span>'; foutVraag = 'Stimmt etwas in diesem Tool nicht?'; foutLink = 'Sag Bescheid'
    vgKop = 'Frag den <span class="groen">Gorilla</span>'; vgUitleg = 'Stell deine Frage in ganz normalen Worten. Kann der Gorilla das Tool für dich ausfüllen, macht er das sofort.'
    vgAria = 'Deine Frage an den Gorilla'; vgPlek = 'Stell deine Frage'; vgKnop = 'Fragen'; vgVoorbeelden = 'Beispielfragen'
    alleenNl = 'Dieses Tool gibt es im Moment nur auf Niederländisch. Die deutsche Version ist unterwegs: Der Gorilla übersetzt gerade.'
    filters = @{ kiezen = 'wählen'; berekenen = 'berechnen'; plannen = 'planen' }
    broodTools = 'Tools'; nieuw = 'Neu'
  }
  orgBeschrijving = 'Unabhängige niederländische Website mit kostenlosen Tools für Gravelfahrer: Gravelbike und Rahmengröße finden, Gravelreifen, Reifendruck, Laufräder, Übersetzung, Gravelrouten, Ultra-Events, Bikepacking-Packliste, Profilsticker und Kleidungsberater.'
  homeTitel = 'Gravelbike finden, Reifendruck und mehr | Gravel Gorilla'
  homeBeschrijving = 'Kostenlose Tools für Gravelfahrer: Gravelbike und Rahmengröße finden, Reifendruck und Übersetzung berechnen, Gravelrouten, Packliste, Kleidungsberater und mehr.'
  lijstNaam = 'Kostenlose Tools für Gravelfahrer'
  getallen = @('null', 'ein', 'zwei', 'drei', 'vier', 'fünf', 'sechs', 'sieben', 'acht', 'neun', 'zehn', 'elf', 'zwölf', 'dreizehn', 'vierzehn', 'fünfzehn', 'sechzehn')
  paginas = @{
    'over-ons' = @{ titel = 'Über Gravel Gorilla: kostenlose Tools für Gravelfahrer'; beschrijving = 'Gravel Gorilla wird von Geert Jans gemacht, Gravelfahrer: kostenlose Tools für Gravelbikes, Reifen, Laufräder, Events und Kleidung. Ehrlich und ohne Konto.' }
    'contact' = @{ titel = 'Kontakt | Gravel Gorilla'; beschrijving = 'Eine Frage, ein Tipp, ein falscher Preis oder eine Idee für ein neues Gravel-Tool? Schreib Gravel Gorilla an info@gravelgorilla.nl. Wir lesen alles.' }
    'privacy' = @{ titel = 'Datenschutzerklärung | Gravel Gorilla'; beschrijving = 'Gravel Gorilla nutzt keine Cookies und keine Werbung. Lies in einfachen Worten, welche Daten die Seite und die Tools nutzen und warum.' }
  }

  tools = @{
    'gravelbike-kiezer' = @{ kop = 'Gravelbike-<wbr><span class="groen">Finder</span>'; titel = 'Gravelbike-Finder'; seoTitel = 'Welches Gravelbike passt zu mir? Gratis Finder | Gravel Gorilla'
