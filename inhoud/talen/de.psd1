    'kledingadvies' = @{ kop = 'Kleidungs<wbr><span class="groen">berater</span>'; titel = 'Kleidungsberater'; seoTitel = 'Was ziehe ich beim Radfahren an? Kleidungsberater | Gravel Gorilla'
