      naamKort = 'Laufrad-Finder'; kort = 'Leicht, robust oder schnell? Finde den Laufradsatz, der zu deinem Rad und Fahrstil passt.'; uitlegKop = 'Über diesen Finder' }
    'ultra-eventkiezer' = @{ kop = 'Ultra-Event-<wbr><span class="groen">Finder</span>'; titel = 'Ultra-Event-Finder'; seoTitel = 'Ultra-Gravel-Events 2027–2028 finden | Gravel Gorilla'
      sub = 'Welches Ultra-Gravel-Event passt zu deiner Erfahrung, Form und Planung?'; beschrijving = 'Kalender mit 80 Ultra-Gravel- und Bikepacking-Events 2027 und 2028. Filtere nach Monat, Land, Distanz, Untergrund und Rad und finde das passende Event.'
      naamKort = 'Ultra-Event-Finder'; kort = 'Welches Ultra-Gravel-Event passt zu deiner Erfahrung, Form und Planung? Du bekommst eine Auswahl.'; uitlegKop = 'Über diesen Finder' }
    'profielsticker' = @{ kop = 'Profil<wbr><span class="groen">sticker</span>'; titel = 'Profilsticker'; seoTitel = 'Profilsticker aus deinem GPX erstellen (gratis) | Gravel Gorilla'
