    @('</span>een gravelbike kiezen</a>', '</span>ein Gravelbike finden</a>'),
    @('</span>mijn bandenspanning weten</a>', '</span>meinen Reifendruck wissen</a>'),
    @('</span>de juiste wielen vinden</a>', '</span>die richtigen Laufräder finden</a>'),
    @('</span>de juiste banden kiezen</a>', '</span>die richtigen Reifen wählen</a>'),
    @('</span>een ultra-event vinden</a>', '</span>ein Ultra-Event finden</a>'),
    @('</span>een profielsticker maken</a>', '</span>einen Profilsticker machen</a>'),
    @('</span>weten wat ik aantrek</a>', '</span>wissen, was ich anziehe</a>'),
    @('</span>mijn framemaat weten</a>', '</span>meine Rahmengröße wissen</a>'),
    @('</span>weten wat ik meeneem</a>', '</span>wissen, was ich einpacke</a>'),
    @('</span>een gravelroute vinden</a>', '</span>eine Gravelroute finden</a>'),
    @('</span>mijn versnellingen berekenen</a>', '</span>meine Übersetzung berechnen</a>'),
